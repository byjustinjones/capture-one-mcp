{
  "name": "capture-one-mcp",
  "version": "0.1.0",
  "description": "MCP server that drives Capture One Pro on macOS via its AppleScript/JXA scripting interface",
  "license": "MIT",
  "type": "module",
  "bin": {
    "capture-one-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "check:jxa": "node scripts/check-jxa.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "tsc --noEmit && node scripts/check-jxa.mjs",
    "verify:live": "node scripts/verify-property-names.mjs",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
